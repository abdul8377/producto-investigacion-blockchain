# Plantilla de configuración futura: la base aún no consume estas variables.
# Copiar a .env.local únicamente al iniciar la fase de integración.
# No utilizar NEXT_PUBLIC_ para secretos ni datos de conexión.

MYSQL_SOURCE_HOST=127.0.0.1
MYSQL_SOURCE_PORT=3306
MYSQL_SOURCE_DATABASE=investigacion_peruschool
MYSQL_SOURCE_USER=
MYSQL_SOURCE_PASSWORD=

MYSQL_EXPERIMENTAL_HOST=127.0.0.1
MYSQL_EXPERIMENTAL_PORT=3306
MYSQL_EXPERIMENTAL_DATABASE=investigacion_experimental
MYSQL_EXPERIMENTAL_USER=
MYSQL_EXPERIMENTAL_PASSWORD=

# Rutas externas del servidor; se definirán con la red Fabric.
FABRIC_GATEWAY_ENDPOINT=
FABRIC_CHANNEL=
FABRIC_CHAINCODE=
FABRIC_MSP_ID=
FABRIC_TLS_CERT_PATH=
FABRIC_IDENTITY_CERT_PATH=
FABRIC_IDENTITY_KEY_PATH=

# Credenciales de laboratorio por definir; no son credenciales institucionales.
LAB_SESSION_SECRET=
BENCHMARK_API_TOKEN=
